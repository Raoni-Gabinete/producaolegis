grafia": null, "cropping": "", "nivel_instrucao": null}, {"id": 78, "__str__": "WALTER GOMES", "link_detail_backend": "/parlamentar/78", "metadata": {}, "data_ultima_atualizacao": "2026-10-14T14:09:05.679163-03:00", "nome_completo": "WALTER GOMES DE ARAÚJO", "nome_parlamentar": "WALTER GOMES", "sexo": "M", "numero_gab_parlamentar": "", "telefone": "", "telefone_celular": "", "endereco_web": "", "profissao": "", "email": "", "locais_atuacao": "", "ativo": false, "biografia": "", "fotografia": null, "cropping": "", "nivel_instrucao": null}, {"id": 513, "__str__": "Wamberto Ulysses", "link_detail_backend": "/parlamentar/513", "metadata": {}, "data_ultima_atualizacao": "2026-10-14T14:09:05.679163-03:00", "nome_completo": "WAMBERTO RAMOS ULYSSES DE CARVALHO", "nome_parlamentar": "Wamberto Ulysses", "sexo": "M", "numero_gab_parlamentar": "", "telefone": "", "telefone_celular": "", "endereco_web": "", "profissao": "", "email": "", "locais_atuacao": "", "ativo": true, "biografia": "<p>Wamberto Ulysses iniciou sua trajet&oacute;ria pol&iacute;tica atuando nos bastidores de campanhas eleitorais. Foi diretor administrativo da R&aacute;dio Tabajara e assessor do deputado estadual Branco Mendes, na Assembleia Legislativa da Para&iacute;ba, por v&aacute;rios anos.&nbsp;</p>\r\n<p>Conquistou expressiva vota&ccedil;&atilde;o nas elei&ccedil;&otilde;es de 2024, tendo como bandeira a defesa intransigente da cidade e das pessoas. Entre as principais frentes de atua&ccedil;&atilde;o do vereador est&atilde;o o autismo, a luta por moradia e o apoio &agrave; comunidade surda. Wamberto Ulysses tamb&eacute;m busca atuar com proximidade da popula&ccedil;&atilde;o.</p>", "fotografia": "http://sapl.joaopessoa.pb.leg.br/media/sapl/public/parlamentar/513/whatsapp_image_2025-03-28_at_12.46.33.jpeg", "cropping": "0,0,300,300", "nivel_instrucao": null}, {"id": 334, "__str__": "Watteau Rodrigues", "link_detail_backend": "/parlamentar/334", "metadata": {}, "data_ultima_atualizacao": "2026-10-14T14:09:05.679163-03:00", "nome_completo": "Watteau Ferreira Rodrigues", "nome_parlamentar": "Watteau Rodrigues", "sexo": "M", "numero_gab_parlamentar": "", "telefone": "", "telefone_celular": "", "endereco_web": "", "profissao": "", "email": "watteaurodrigues@cmjp.pb.gov.br", "locais_atuacao": "", "ativo": false, "biografia": "", "fotografia": null, "cropping": "", "nivel_instrucao": 2}, {"id": 399, "__str__": "Welando Guedes de Lima  (Suplente)", "link_detail_backend": "/parlamentar/399", "metadata": {}, "data_ultima_atualizacao": "2026-10-14T14:09:05.679163-03:00", "nome_completo": "Welando Guedes Matias de Lima", "nome_parlamentar": "Welando Guedes de Lima  (Suplente)", "sexo": "M", "numero_gab_parlamentar": "", "telefone": "", "telefone_celular": "", "endereco_web": "", "profissao": "", "email": "", "locais_atuacao": "", "ativo": false, "biografia": "", "fotografia": null, "cropping": "", "nivel_instrucao": 2}, {"id": 107, "__str__": "WILSON BRAGA", "link_detail_backend": "/parlamentar/107", "metadata": {}, "data_ultima_atualizacao": "2026-10-14T14:09:05.679163-03:00", "nome_completo": "WILSON LEITE BRAGA", "nome_parlamentar": "WILSON BRAGA", "sexo": "M", "numero_gab_parlamentar": "", "telefone": "", "telefone_celular": "", "endereco_web": "", "profissao": "", "email": "", "locais_atuacao": "", "ativo": false, "biografia": "", "fotografia": null, "cropping": "", "nivel_instrucao": null}, {"id": 196, "__str__": "WLDIR BEZERRA", "link_detail_backend": "/parlamentar/196", "metadata": {}, "data_ultima_atualizacao": "2026-10-14T14:09:05.679163-03:00", "nome_completo": "ANTONIO WALDIR BEZERRA CAVALCANTI", "nome_parlamentar": "WLDIR BEZERRA", "sexo": "M", "numero_gab_parlamentar": "", "telefone": "", "telefone_celular": "", "endereco_web": "", "profissao": "", "email": "", "locais_atuacao": "", "ativo": false, "biografia": "", "fotografia": null, "cropping": "", "nivel_instrucao": null}, {"id": 345, "__str__": "Zezinho Botafogo", "link_detail_backend": "/parlamentar/345", "metadata": {}, "data_ultima_atualizacao": "2026-10-14T14:09:05.679163-03:00", "nome_completo": "José Freire da Costa", "nome_parlamentar": "Zezinho Botafogo", "sexo": "M", "numero_gab_parlamentar": "32186384", "telefone": "32186384", "telefone_celular": "", "endereco_web": "", "profissao": "", "email": "zezinhobotafogo@joaopessoa.pb.leg.br", "locais_atuacao": "", "ativo": true, "biografia": "<p><span style=\"font-family: Arial; font-size: 14.6667px; text-align: justify; white-space: pre-wrap;\">Jos&eacute; Freire da Costa nasceu em Tapero&aacute; e mudou-se para Jo&atilde;o Pessoa logo na inf&acirc;ncia. Durante muitos anos, trabalhou como balconista em uma lanchonete no Ponto de Cem R&eacute;is, no Centro da Capital. Depois, tornou-se propriet&aacute;rio do estabelecimento. Foi presidente da equipe profissional do time Botafogo da Para&iacute;ba, e &eacute; bastante conhecido na &aacute;rea de esporte em Jo&atilde;o Pessoa, pois mant&eacute;m um excelente relacionamento com atletas e desportistas nos bairros da Capital. Foi vereador por quatro mandatos consecutivos. Em 2016, obteve 3.872 votos, ficando na primeira supl&ecirc;ncia pela coliga&ccedil;&atilde;o PSB/PEN/PRP. Tem como bandeiras de luta as pol&iacute;ticas p&uacute;blicas em favor do esporte, da educa&ccedil;&atilde;o e sa&uacute;de. Foi reeleito como vereador com 4.641 votos no pleito de 2020.</span></p>", "fotografia": "http://sapl.joaopessoa.pb.leg.br/media/sapl/public/parlamentar/345/img-20211005-wa0044.jpg", "cropping": "265,136,981,853", "nivel_instrucao": null}]}